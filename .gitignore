data_dump.sql
*.dump


# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/


# ─────────────────────────────────────────────
# Operating system junk
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini


