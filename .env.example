# Copy to .env and fill in your own values:
#   cp .env.example .env

# One password. docker-compose hands it to every service as
# DESTINATION_POSTGRES_PASSWORD, so there is only one secret to manage.
POSTGRES_PASSWORD=choose_a_password

# Free personal key from https://finnhub.io -- required, deliberately blank.
FINNHUB_API_KEY=

STOCK_SYMBOLS=AMZN,NVDA,GOOGL,TSLA,NFLX
POLL_INTERVAL_SECONDS=15
MARKET_CLOSED_POLL_SECONDS=300

FINNHUB_RATE_PER_MINUTE=60
FINNHUB_RATE_BURST=10
FINNHUB_MAX_RETRIES=4
FINNHUB_TIMEOUT_SECONDS=10

BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=60

HISTORY_HOURS=24

# ---- auth ----
# Signs the API's JWTs. Generate one with: openssl rand -hex 32
# At least 32 characters, or the api refuses to start.
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600

# The one admin the API creates at startup, if BOTH are set. Blank on purpose:
# a default password in an example file becomes a default password in
# production. Leave them empty and the api starts with no admin at all.
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=

# Where the dashboard reaches the API. Inside compose this is the service name.
API_BASE_URL=http://api:8000
API_TIMEOUT_SECONDS=10
